manifest {
    name            = 'angelovangel/faster-report'
    author          = 'Angel Angelov'
    homePage        = 'https://github.com/angelovangel/faster-report'
    description     = 'Generate interactive HTML quality control reports for FASTQ/BAM files.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=21.04.0'
    version         = '1.0.0'
}

params {
    reads     = null
    type      = null
    rundate   = null
    flowcell  = null
    basecall  = null
    user      = null
    save_raw  = false
    subsample = 1.0
    outfile   = 'faster-report.html'
    outdir    = 'output'
    help      = false
}

process {
    cpus      = 4
    memory    = '8 GB'
}

profiles {
    standard {
        docker.enabled = true
    }

    singularity {
        singularity.enabled = true
        singularity.cacheDir = "$HOME/singularity-cache"
        singularity.runOptions = '--no-home'
    }
}
